# 默认本地 JSON 模式
TRACKER_STORAGE=json

# PostgreSQL 模式示例
# TRACKER_STORAGE=postgres
# TRACKER_DATABASE_URL=postgres://study_tracker_app:change_me@localhost:5432/study_tracker?sslmode=disable
# 部署环境建议开启：若配置缺失，服务会拒绝以 JSON 模式启动。
# TRACKER_REQUIRE_POSTGRES=true

# 登录认证密钥。生产环境请换成固定的强随机字符串，不要提交真实密钥。
TRACKER_JWT_SECRET=change_me_to_a_long_random_secret

# HTTPS 生产环境示例：设置公开地址后 Cookie 会自动启用 Secure；也可显式指定。
# TRACKER_PUBLIC_URL=https://tracker.example.com
# TRACKER_COOKIE_SECURE=true

# 可选的独立加密密钥。未设置时应用会在 data 目录生成仅本机可读的密钥。
# TRACKER_ENCRYPTION_KEY=change_me_to_a_second_long_random_secret

# 服务监听配置
TRACKER_HOST=127.0.0.1
TRACKER_PORT=8000
GIN_MODE=release

# 可选：也可以在应用设置页保存 MinerU Token。
# MINERU_TOKEN=change_me
