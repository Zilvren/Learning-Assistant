# Replace both secrets before starting the stack. Keep this file private.
POSTGRES_DB=study_tracker
POSTGRES_USER=study_tracker
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
TRACKER_JWT_SECRET=replace-with-a-long-random-jwt-secret

# IP-address access starts with HTTP. Change this to true only after HTTPS is
# enabled with a domain name.
TRACKER_COOKIE_SECURE=false

# Leave this true only long enough to create the first account. Set it to
# false and restart the app so strangers cannot create accounts.
TRACKER_REGISTRATION_ENABLED=true
