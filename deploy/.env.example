# Replace both secrets before starting the stack. Keep this file private.
POSTGRES_DB=study_tracker
POSTGRES_USER=study_tracker
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
TRACKER_JWT_SECRET=replace-with-a-long-random-jwt-secret

# IP-address access starts with HTTP. Change this to true only after HTTPS is
# enabled with a domain name.
TRACKER_COOKIE_SECURE=false

# Leave this true only long enough to create the first account. Set it to
# false and restart the app so strangers cannot create accounts.
TRACKER_REGISTRATION_ENABLED=true

# Email verification is disabled until a verified HTTPS domain and SMTP account
# are configured. Do not enable it for a plain HTTP IP address.
TRACKER_EMAIL_VERIFICATION_ENABLED=false
TRACKER_PUBLIC_URL=https://study.example.com
TRACKER_SMTP_HOST=smtp.example.com
TRACKER_SMTP_PORT=465
TRACKER_SMTP_USERNAME=mailer@example.com
TRACKER_SMTP_PASSWORD=replace-with-an-smtp-app-password
TRACKER_SMTP_FROM=mailer@example.com
# implicit (port 465), starttls (usually port 587), or none (local relay only)
TRACKER_SMTP_TLS_MODE=implicit
TRACKER_EMAIL_VERIFICATION_TTL=24h
